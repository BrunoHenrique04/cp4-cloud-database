{
  "info": {
    "name": "CP4 - Cloud Database - API de Alunos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Testes da API REST de alunos (FastAPI + MongoDB). Execute em ordem (Run collection). Antes de rodar de novo, limpe a coleção 'alunos' para o teste 2 não dar 409."
  },
  "item": [
    {
      "name": "1. Cadastrar aluno (João)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/alunos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@email.com\",\n  \"idade\": 22,\n  \"curso\": \"Ciência da Computação\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('alunoId', pm.response.json().aluno.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Cadastrar aluno (Maria)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/alunos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Maria Santos\",\n  \"email\": \"maria@email.com\",\n  \"idade\": 24,\n  \"curso\": \"Engenharia de Software\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Listar todos os alunos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/alunos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Retorna uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Consultar aluno por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/alunos/{{alunoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos",
            "{{alunoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Atualizar aluno",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/alunos/{{alunoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos",
            "{{alunoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João da Silva\",\n  \"email\": \"joao.silva@email.com\",\n  \"idade\": 23,\n  \"curso\": \"Engenharia de Software\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Curso atualizado', () => pm.expect(pm.response.json().aluno.curso).to.eql('Engenharia de Software'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Requisição inválida (validação)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/alunos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"\",\n  \"email\": \"email_invalido\",\n  \"idade\": 12,\n  \"curso\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. E-mail duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/alunos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Outra Maria\",\n  \"email\": \"maria@email.com\",\n  \"idade\": 24,\n  \"curso\": \"Engenharia de Software\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Excluir aluno",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/alunos/{{alunoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos",
