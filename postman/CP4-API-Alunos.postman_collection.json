            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Consultar aluno excluído (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/alunos/{{alunoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos",
            "{{alunoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Excluir aluno inexistente (404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/alunos/{{alunoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos",
            "{{alunoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
